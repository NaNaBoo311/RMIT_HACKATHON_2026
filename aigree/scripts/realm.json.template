      "enabled": true,
      "emailVerified": false,
      "attributes": {
        "tideInvitable": [
          "true"
        ]
      },
      "realmRoles": [
        "default-roles-REALM_NAME",
        "benh_nhan",
        "_tide_encryptor",
        "_tide_decryptor"
      ]
    },
    {
