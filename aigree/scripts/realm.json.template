{
  "realm": "REALM_NAME",
  "accessTokenLifespan": 300,
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "duplicateEmailsAllowed": true,
  "roles": {
    "realm": [
      { "name": "appUser", "description": "Standard application user" },
      { "name": "_tide_enabled", "description": "Represents a tide user thats allowed perform actions on tide" },
      { "name": "_tide_encryptor", "description": "RelationshipAttestation:1: may encrypt records a policy grants to this user (name fixed by the ORK contract). Capability only; the policy subject decides which records." },
      { "name": "_tide_decryptor", "description": "RelationshipAttestation:1: may decrypt records a policy grants to this user (name fixed by the ORK contract). Capability only; the policy subject decides which records." },
      { "name": "benh_nhan", "description": "AIgree: patient (also family members)" },
      { "name": "bac_si", "description": "AIgree: doctor" },
      { "name": "benh_vien", "description": "AIgree: hospital account (co-signs grants, cannot read records)" },
      { "name": "khoa_mat", "description": "AIgree: licensed for Ophthalmology" },
      { "name": "khoa_noitiet", "description": "AIgree: licensed for Endocrinology" },
      { "name": "khoa_capcuu", "description": "AIgree: licensed for Emergency" },
      { "name": "_tide_vault.selfencrypt", "description": "Encrypt data with tag: vault" },
      { "name": "_tide_vault.selfdecrypt", "description": "Decrypt data with tag: vault" },
      {
        "name": "default-roles-REALM_NAME",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": { "realm": ["_tide_enabled", "appUser", "_tide_vault.selfencrypt", "_tide_vault.selfdecrypt"] }
      }
    ],
    "client": { "CLIENT_NAME": [] }
  },
  "defaultRole": {
    "name": "default-roles-REALM_NAME",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "users": [
    {
      "username": "lan",
      "firstName": "Lan",
