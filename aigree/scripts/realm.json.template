      ]
    },
    {
      "username": "nam",
      "firstName": "Nam",
      "lastName": "Nguyễn Văn",
      "enabled": true,
      "emailVerified": false,
      "attributes": {
        "tideInvitable": [
          "true"
        ]
      },
      "realmRoles": [
        "default-roles-REALM_NAME",
        "benh_nhan",
