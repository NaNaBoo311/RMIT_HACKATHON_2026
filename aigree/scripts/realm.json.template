      ]
    },
    {
      "username": "minh",
      "firstName": "Minh",
      "lastName": "Lê",
      "enabled": true,
      "emailVerified": false,
      "attributes": {
        "tideInvitable": [
          "true"
        ]
      },
      "realmRoles": [
        "default-roles-REALM_NAME",
        "bac_si",
        "khoa_mat",
