# ---------------------------------------------------------------------------
# .env  (read by scripts/init-tidecloak.sh; gitignored)
# ---------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Answered by the deployment owner only (AP-90): https://tide.org/legal
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=

# ---------------------------------------------------------------------------
# .env.local  (read by Next.js; gitignored). Placeholders only here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://yizzqzuajhygdvfhbpmi.supabase.co
SUPABASE_ANON_KEY="<public anon key - not used by the browser in this design>"
SUPABASE_SERVICE_ROLE_KEY="<Supabase -> Project Settings -> API; server only, never commit>"

TIDECLOAK_URL=http://localhost:8080
TIDECLOAK_REALM=sealedchart

CCCD_HMAC_SECRET="<random 32+ byte string>"
LLM_API_KEY="<OpenRouter (or any OpenAI-compatible) API key for the visit assistant>"
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# TideCloak mode (server + browser must match): "live" (real TideCloak, default) or "local"
# (stand-in in tide-local/, start it with `npm run tide:local`). The server accepts only its mode's tokens.
TIDE_MODE=live
NEXT_PUBLIC_TIDE_MODE=live
NEXT_PUBLIC_TIDE_LOCAL_URL=http://localhost:8090
