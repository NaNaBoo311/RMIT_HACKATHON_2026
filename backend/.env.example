# AUTH_MODE=dev accepts X-Dev-User / X-Dev-Roles headers (no realm needed). Use "tide" for real JWT.
AUTH_MODE=dev
CORE_AI_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000

# Tier policy
QUORUM_THRESHOLD=2
QUORUM_RISK=0.5
SINGLE_RISK=0.2
APPROVER_ROLE=approver

# TideCloak (only used when AUTH_MODE=tide)
TIDECLOAK_URL=http://localhost:8080
TIDECLOAK_REALM=quorumgate
TIDECLOAK_CLIENT_ID=quorumgate-app
# TIDECLOAK_AUDIENCE=   # optional, defaults to client id; leave empty to skip aud check
